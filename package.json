{
  "name": "twitch-plays-gb",
  "version": "0.1.1",
  "description": "Twitch Plays GB — local Game Boy/GBC/GBA chat-driven emulator for OBS streaming",
  "license": "MIT",
  "author": {
    "name": "Hannes Michael",
    "email": "hannes@hannes-michael.dev"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "main": "dist/desktop/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "cross-env TPG_DEV=1 TPG_TEST=0 tsx watch src/server/index.ts",
    "dev:electron": "node scripts/dev-electron.mjs",
    "build": "npm run build:web && npm run build:server && npm run build:desktop",
    "build:web": "vite build",
    "build:server": "tsup src/server/index.ts --format esm --platform node --target node22 --out-dir dist/server --sourcemap --clean --external vite --external node-mgba --external @twurple/auth --external @twurple/chat",
    "build:desktop": "tsup src/desktop/main.ts src/desktop/preload.ts --format cjs --platform node --target node22 --out-dir dist/desktop --sourcemap --clean --external electron",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install",
    "package:linux": "npm run build && electron-builder --linux --publish never",
    "package:win": "npm run build && electron-builder --win --publish never",
    "bundle": "node scripts/package-release.mjs",
    "bundle:linux": "node scripts/package-release.mjs --linux",
    "bundle:win": "node scripts/package-release.mjs --win",
    "bundle:all": "node scripts/package-release.mjs --all",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "start": "node dist/server/index.js"
  },
  "dependencies": {
    "@twurple/auth": "^8.2.0",
    "@twurple/chat": "^8.2.0",
    "express": "^5.3.0",
    "node-mgba": "0.3.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "build": {
    "appId": "dev.twitchplaysgb.app",
    "productName": "Twitch Plays GB",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "dist/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "maintainer": "Hannes Michael <hannes@hannes-michael.dev>"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  }
}
