# This file documents supported environment variables. It is NOT loaded
# automatically yet; export these in your shell (dotenv support is planned).

# Server
HOST=127.0.0.1
PORT=3000

# Local data (ROMs, saves, config). Empty = data/dev when TPG_DEV=1,
# platform default otherwise. Required (do not leave empty) when TPG_TEST=1.
TPG_DATA_DIR=

# Optional JSON config path. Empty = <dataDir>/config.json.
TPG_CONFIG=

# ROM to boot (.gb, .gbc, or .gba). Empty = server starts without an emulator.
# The desktop shell resolves relative paths against its cwd, then the data dir.
TPG_ROM=

# Logging: debug, info, warn, error.
TPG_LOG_LEVEL=info

# Twitch channel (without the leading #). Empty = not configured.
TPG_CHANNEL=

# Development flags. Never enable in production.
TPG_DEV=0
TPG_TEST=0

# Electron desktop shell: local server to load. Must be a loopback address.
# Leave empty to spawn the built server child with Electron-as-Node.
TPG_SERVER_URL=

# Open the dedicated OBS capture window at startup (1/0).
TPG_CAPTURE=0

# Headless packaged smoke mode (also --self-test). No windows, menu, or dialogs.
# Intended for scripts/CI; stops the server child before exiting.
TPG_SELF_TEST=0

# Reserved for later (P1). Not read by loadConfig yet.
# Overlay/democracy timings (milliseconds/frames). Leave empty for defaults.
TPG_DEMOCRACY_WINDOW_MS=
TPG_HOLD_FRAMES=
TPG_RELEASE_FRAMES=
