# This file documents supported environment variables. It is NOT loaded
# automatically yet; export these in your shell (dotenv support is planned).

# Server
HOST=127.0.0.1
PORT=3000

# Local data (ROMs, saves, config). Empty = data/dev when TPG_DEV=1,
# platform default otherwise. Required (do not leave empty) when TPG_TEST=1.
TPG_DATA_DIR=

# Optional JSON config path. Empty = <dataDir>/config.json.
TPG_CONFIG=

# ROM to boot (.gb, .gbc, or .gba). Empty = server starts without an emulator.
# The desktop shell resolves relative paths against its cwd, then the data dir.
TPG_ROM=

# Logging: debug, info, warn, error.
TPG_LOG_LEVEL=info

# Twitch channel (without the leading #). Empty = not configured.
TPG_CHANNEL=

# Chat source policy: auto, fake, or twitch. Tests always use fake chat and
# never touch the network. With a channel configured, dev and production use
# anonymous read-only Twitch chat. Dev falls back to fake when no channel is
# configured; TPG_CHAT=fake forces the fake source in dev.
TPG_CHAT=auto

# Accept input commands without the leading ! (1/0). Default: 0.
TPG_BARE_COMMANDS=0

# Development flags. Never enable in production.
TPG_DEV=0
TPG_TEST=0

# Electron desktop shell: local server to load. Must be a loopback address.
# Leave empty to spawn the built server child with Electron-as-Node.
TPG_SERVER_URL=

# Open the dedicated OBS capture window at startup (1/0).
TPG_CAPTURE=0

# Headless packaged smoke mode (also --self-test). No windows, menu, or dialogs.
# Intended for scripts/CI; stops the server child before exiting.
TPG_SELF_TEST=0

# Optional JSON result path for self-test (used by the packaged smoke harness).
TPG_SELF_TEST_RESULT=

# Chat/input timings exposed through the developer debug panel.
# Ranges: windows/cooldown/stale 1..3600000 ms (cooldown/stale may be 0 to
# disable), frames 1..600, queue 1..1000, rate 1..1000 per second.
# Empty = defaults shown.
TPG_DEMOCRACY_WINDOW_MS=15000
TPG_HOLD_FRAMES=8
TPG_RELEASE_FRAMES=4
TPG_INPUT_COOLDOWN_MS=3000
TPG_INPUT_MAX_QUEUE=10
TPG_INPUT_MAX_PER_SECOND=5
TPG_INPUT_STALE_MS=5000

# Emulator autosave interval in milliseconds (100..3600000). Save states keep
# two generations and restore on boot; Stop/Restart/quit also save.
TPG_AUTOSAVE_INTERVAL_MS=60000
