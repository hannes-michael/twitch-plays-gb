{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Server (dev, tsx)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--import", "tsx", "src/server/index.ts", "--port", "3000"],
      "env": { "TPG_DEV": "1", "TPG_TEST": "0" },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Electron main (dev server required)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/node_modules/electron/dist/electron",
      "windows": {
        "runtimeExecutable": "${workspaceFolder}/node_modules/electron/dist/electron.exe"
      },
      "program": "${workspaceFolder}/dist/desktop/main.cjs",
      "runtimeArgs": ["--user-data-dir=${workspaceFolder}/data/dev/electron"],
      "preLaunchTask": "build:desktop",
      "env": { "TPG_SERVER_URL": "http://127.0.0.1:3000" },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Playwright: chromium",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "${workspaceFolder}/node_modules/@playwright/test/cli.js",
        "test",
        "--project=chromium"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Playwright: electron",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "${workspaceFolder}/node_modules/@playwright/test/cli.js",
        "test",
        "--project=electron"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
